# Local Postgres from docker-compose.yml. One URL for the app, its migrations and
# pg-boss (ADR-0020); it must be a direct connection, never a transaction pooler.
# A worktree's .env.local points it at the worktree's own database.
DATABASE_URL="postgres://postgres:postgres@localhost:5435/enescena"

# Dev server port. A worktree's .env.local overrides it (`pnpm db:worktree`).
PORT="3000"

# Better Auth. BETTER_AUTH_SECRET signs sessions: `openssl rand -base64 32`,
# one per environment. BETTER_AUTH_URL is the app's public origin.
BETTER_AUTH_SECRET="replace-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
