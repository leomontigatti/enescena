{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // `shadcn` is a dev dependency on purpose: besides the CLI that adds
  // components (docs/agents/shadcn.md), it provides `shadcn/tailwind.css`, which
  // src/styles.css imports and Vite bundles at build time. The runtime image is
  // pruned to production dependencies and does not need it.
  "ignoreDependencies": ["shadcn"],
  "duplicates": {
    // Pair-only clones are hidden; widespread copy-paste is what is worth a refactor.
    "minOccurrences": 3
  },
  "rules": {
    // ADR-0020 dependencies land before the features that import them (zod,
    // date-fns, TanStack Form...). Reported, not failed; the list empties as
    // features arrive, and anything still on it later is a candidate to remove.
    "unused-dependencies": "warn"
  }
}
